ORGANIZATION_BLOCK MAIN:OB1
TITLE=主程序
BEGIN
Network 1 // 首次扫描初始化
LD     SM0.1
CALL   SBR0
Network 2 // 模拟量处理与报警
LD     SM0.0
CALL   SBR1
Network 3 // 流量计算
LD     SM0.0
CALL   SBR2
Network 4 // 开关机顺控
LD     SM0.0
CALL   SBR3
END_ORGANIZATION_BLOCK

SUBROUTINE_BLOCK SBR_INIT:SBR0
TITLE=初始化参数
BEGIN
Network 1 // 设置HMI默认参数 (首次扫描执行)
LD     SM0.1
MOVR   1.6, VD2000
MOVR   10.0, VD2004
MOVR   0.2, VD2008
MOVR   80.0, VD2012
MOVR   2223.0, VD2016
MOVW   13824, VW2020
MOVW   18000, VW2022
Network 2 // 初始化高速计数器
LD     SM0.1
MOVB   16#F8, SMB37
HDEF   0, 0
HSC    0
MOVB   16#F8, SMB47
HDEF   1, 0
HSC    1
END_SUBROUTINE_BLOCK

SUBROUTINE_BLOCK SBR_ANALOG:SBR1
TITLE=模拟量处理
BEGIN
Network 1 // AIW16 压力转换 0-1.6MPa
LD     SM0.0
ITD    AIW16, AC0
DTR    AC0, AC0
-R     5530.0, AC0
*R     1.6, AC0
/R     22118.0, AC0
MOVR   AC0, VD2100
Network 2 // 压力下限截断
LD     SM0.0
AR<    VD2100, 0.0
MOVR   0.0, VD2100
Network 3 // AIW18 液位转换 0-100%
LD     SM0.0
ITD    AIW18, AC0
DTR    AC0, AC0
-R     5530.0, AC0
*R     100.0, AC0
/R     22118.0, AC0
MOVR   AC0, VD2104
Network 4 // 液位下限截断
LD     SM0.0
AR<    VD2104, 0.0
MOVR   0.0, VD2104
Network 5 // 压力上限报警判定 (高于上限报警)
LD     SM0.0
AR>    VD2100, VD2000
=      V2303.0
Network 6 // 液位下限报警判定 (低于下限报警)
LD     SM0.0
AR<    VD2104, VD2004
=      V2303.1
Network 7 // 阳极泵速输出 (运行)
LD     M1.0
MOVW   VW2020, AQW32
Network 8 // 阳极泵速输出 (停止)
LDN    M1.0
MOVW   0, AQW32
Network 9 // 阴极泵速输出 (运行)
LD     M1.1
MOVW   VW2020, AQW34
Network 10 // 阴极泵速输出 (停止)
LDN    M1.1
MOVW   0, AQW34
END_SUBROUTINE_BLOCK

SUBROUTINE_BLOCK SBR_FLOW:SBR2
TITLE=流量计算
BEGIN
Network 1 // 1秒节拍器
LD     SM0.0
AN     T42
TON    T42, +100
Network 2 // 流量计1脉冲计算
LD     T42
MOVD   HC0, VD1200
MOVD   VD1200, VD1208
-D     VD1204, VD1208
MOVD   VD1200, VD1204
Network 3 // 流量计2脉冲计算
LD     T42
MOVD   HC1, VD1220
MOVD   VD1220, VD1228
-D     VD1224, VD1228
MOVD   VD1220, VD1224
Network 4 // 流量计1瞬时与累计换算
LD     SM0.0
DTR    VD1208, AC0
*R     60.0, AC0
/R     VD2016, AC0
MOVR   AC0, VD1310
DTR    VD1200, AC1
/R     VD2016, AC1
MOVR   AC1, VD1314
Network 5 // 流量计2瞬时与累计换算
LD     SM0.0
DTR    VD1228, AC0
*R     60.0, AC0
/R     VD2016, AC0
MOVR   AC0, VD1330
DTR    VD1220, AC1
/R     VD2016, AC1
MOVR   AC1, VD1334
END_SUBROUTINE_BLOCK

SUBROUTINE_BLOCK SBR_SEQ:SBR3
TITLE=顺控逻辑
BEGIN
Network 1 // HMI 启动指令
LD     V2302.0
EU
MOVB   10, VB100
Network 2 // HMI 停止指令
LD     V2302.1
EU
MOVB   10, VB101
Network 3 // 联锁保护 (异常触发停机)
LD     V2303.0
O      V2303.1
EU
MOVB   10, VB101
MOVB   0, VB100
Network 4 // 制水完成判定
LD     SM0.0
LDB=   VB100, 10
AR>=   VD2104, VD2012
R      Q0.0, 1
MOVB   20, VB100
Network 5 // 未达标开启制水
LD     SM0.0
LDB=   VB100, 10
AR<    VD2104, VD2012
S      Q0.0, 1
Network 6 // 启动空压机
LD     SM0.0
LDB=   VB100, 20
S      Q0.6, 1
MOVB   30, VB100
Network 7 // 延时3秒开阳极电磁阀
LD     SM0.0
LDB=   VB100, 30
TON    T37, +30
Network 8
LD     T37
S      Q0.1, 1
MOVB   40, VB100
Network 9 // 延时3秒开阳极泵
LD     SM0.0
LDB=   VB100, 40
TON    T38, +30
Network 10
LD     T38
S      M1.0, 1
Network 11 // 压力达标跳下一步
LD     SM0.0
LDB=   VB100, 40
AR>=   VD2100, VD2008
MOVB   50, VB100
Network 12 // 开阴极泵
LD     SM0.0
LDB=   VB100, 50
S      M1.1, 1
TON    T39, +30
Network 13 // 延时3秒开阴极电磁阀
LD     T39
S      Q0.2, 1
MOVB   60, VB100
Network 14 // 延时5分钟开直流电源
LD     SM0.0
LDB=   VB100, 60
TON    T40, +3000
Network 15
LD     T40
S      Q0.3, 1
MOVB   100, VB100
Network 16 // 关机指令触发
LD     SM0.0
LDB=   VB101, 10
R      Q0.3, 1
R      M1.0, 2
R      Q0.1, 2
R      Q0.0, 1
S      M10.1, 1
MOVB   0, VB101
Network 17 // 关机延时计时
LD     SM0.0
A      M10.1
TON    T41, VW2022
Network 18 // 延时到达关空压机
LD     T41
R      Q0.6, 1
R      M10.1, 1
END_SUBROUTINE_BLOCK
