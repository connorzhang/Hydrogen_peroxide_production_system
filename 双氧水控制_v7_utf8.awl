﻿﻿﻿ORGANIZATION_BLOCK MAIN:OB1
TITLE= ==========================================
//  初始化与急停复位
//  ==========================================
BEGIN
Network 1
// 首次扫描初始化（清零状态与输出）

LD     SM0.1  // 读取 首次扫描(SM0.1)
MOVB   0, VB100  // 开机顺控状态清零
MOVB   0, VB101  // 关机顺控状态清零
R      Q0.0, 8  // 复位输出 Q0.0~Q0.7
R      Q1.0, 1  // 复位 直流电源(Q1.0)，数量=1
R      M0.0, 2  // 复位 M0.0~M0.1（泵使能）
MOVW   13824, VW1120  // 写入 VW1120 = 13824（默认5V，阳极泵给定）
MOVW   13824, VW1122  // 写入 VW1122 = 13824（默认5V，阴极泵给定）

Network 2
// 急停处理（I0.3）

LD     I0.3  // 读取 急停(I0.3)
MOVB   0, VB100  // 开机顺控状态清零
MOVB   0, VB101  // 关机顺控状态清零
R      Q0.0, 8  // 复位输出 Q0.0~Q0.7
R      Q1.0, 1  // 复位 直流电源(Q1.0)，数量=1
R      M0.0, 2  // 复位 M0.0~M0.1（泵使能）
MOVW   13824, VW1120  // 写入 VW1120 = 13824（默认5V，阳极泵给定）
MOVW   13824, VW1122  // 写入 VW1122 = 13824（默认5V，阴极泵给定）

// ==========================================
// 开机关机触发
// ==========================================
Network 3
// 开机触发（I0.1）

LD     I0.1  // 读取 开机按钮(I0.1)
AN     I0.3  // 与非 急停(I0.3)
AB=    VB100, 0  // 判断 开机顺控状态(VB100) = 0
AB=    VB101, 0  // 判断 关机顺控状态(VB101) = 0
MOVB   10, VB100  // 开机进入步骤10（补水）

Network 4
// 关机触发（I0.2）

LD     I0.2  // 读取 关机按钮(I0.2)
AN     I0.3  // 与非 急停(I0.3)
MOVB   0, VB100  // 开机顺控状态清零
MOVB   10, VB101  // 关机进入步骤10（立即停）

// ==========================================
// AE08 模拟量采集 (8路 4-20mA)
// 说明：按 S7-200 SMART 的固定映射惯例，首个右侧信号模块的模拟量起始通常为 AIW16。
// 若你的系统块里显示的起始地址不同，只需改这里的 AIWxx。
// ==========================================
Network 5
// AE08 CH0 采集：压力 -> VW1000

LD     SM0.0  // 读取 Always_On(SM0.0)
MOVW   AIW16, VW1000  // 采集模拟量到 压力原始值(VW1000)

Network 6
// AE08 CH1 采集：阳极液位 -> VW1002

LD     SM0.0  // 读取 Always_On(SM0.0)
MOVW   AIW18, VW1002  // 采集模拟量到 阳极液位原始值(VW1002)

Network 7
// AE08 CH2 采集：阴极液位 -> VW1004

LD     SM0.0  // 读取 Always_On(SM0.0)
MOVW   AIW20, VW1004  // 采集模拟量到 阴极液位原始值(VW1004)

Network 8
// AE08 CH3 预留 -> VW1010

LD     SM0.0  // 读取 Always_On(SM0.0)
MOVW   AIW22, VW1010  // 采集模拟量到 VW1010

Network 9
// AE08 CH4 预留 -> VW1012

LD     SM0.0  // 读取 Always_On(SM0.0)
MOVW   AIW24, VW1012  // 采集模拟量到 VW1012

Network 10
// AE08 CH5 预留 -> VW1014

LD     SM0.0  // 读取 Always_On(SM0.0)
MOVW   AIW26, VW1014  // 采集模拟量到 VW1014

Network 11
// AE08 CH6 预留 -> VW1016

LD     SM0.0  // 读取 Always_On(SM0.0)
MOVW   AIW28, VW1016  // 采集模拟量到 VW1016

Network 12
// AE08 CH7 预留 -> VW1018

LD     SM0.0  // 读取 Always_On(SM0.0)
MOVW   AIW30, VW1018  // 采集模拟量到 VW1018

// ==========================================
// 开机顺控状态机 (VB100)
// ==========================================
Network 13
// 开机步骤10：开制水+开补水阀

LD     SM0.0  // 读取 Always_On(SM0.0)
AB=    VB100, 10  // 判断 开机顺控状态(VB100) = 10
S      Q0.7, 1  // 置位 制水机(Q0.7)
S      Q0.2, 1  // 置位 阳极补水阀(Q0.2)
S      Q0.3, 1  // 置位 阴极补水阀(Q0.3)

Network 14
// 开机步骤10：阳极液位达标关阳极补水

LD     SM0.0  // 读取 Always_On(SM0.0)
AB=    VB100, 10  // 判断 开机顺控状态(VB100) = 10
AW>=   VW1002, 100  // 模拟量阈值比较（达到则进入下一步）
R      Q0.2, 1  // 复位 阳极补水阀(Q0.2)，数量=1

Network 15
// 开机步骤10：阴极液位达标关阴极补水

LD     SM0.0  // 读取 Always_On(SM0.0)
AB=    VB100, 10  // 判断 开机顺控状态(VB100) = 10
AW>=   VW1004, 100  // 模拟量阈值比较（达到则进入下一步）
R      Q0.3, 1  // 复位 阴极补水阀(Q0.3)，数量=1

Network 16
// 开机步骤10：两路补水阀都关 -> 进入步骤20

LD     SM0.0  // 读取 Always_On(SM0.0)
AB=    VB100, 10  // 判断 开机顺控状态(VB100) = 10
AN     Q0.2  // 与非 阳极补水阀(Q0.2)
AN     Q0.3  // 与非 阴极补水阀(Q0.3)
MOVB   20, VB100  // 开机进入步骤20（空压机）

Network 17
// 开机步骤20：启动空压机并计时3秒

LD     SM0.0  // 读取 Always_On(SM0.0)
AB=    VB100, 20  // 判断 开机顺控状态(VB100) = 20
S      Q0.6, 1  // 置位 空压机(Q0.6)
TON    T37, 30  // 定时器 T37：3秒（100ms基准）

Network 18
// 开机步骤20：3秒到 -> 进入步骤30

LD     SM0.0  // 读取 Always_On(SM0.0)
AB=    VB100, 20  // 判断 开机顺控状态(VB100) = 20
A      T37  // 与 3秒延时(T37)
MOVB   30, VB100  // 开机进入步骤30（阳极阀）

Network 19
// 开机步骤30：开阳极电磁阀并计时3秒

LD     SM0.0  // 读取 Always_On(SM0.0)
AB=    VB100, 30  // 判断 开机顺控状态(VB100) = 30
S      Q0.4, 1  // 置位 阳极电磁阀(Q0.4)
TON    T38, 30  // 定时器 T38：3秒（100ms基准）

Network 20
// 开机步骤30：3秒到 -> 进入步骤40

LD     SM0.0  // 读取 Always_On(SM0.0)
AB=    VB100, 30  // 判断 开机顺控状态(VB100) = 30
A      T38  // 与 3秒延时(T38)
MOVB   40, VB100  // 开机进入步骤40（阳极泵）

Network 21
// 开机步骤40：启动阳极泵（使能位）

LD     SM0.0  // 读取 Always_On(SM0.0)
AB=    VB100, 40  // 判断 开机顺控状态(VB100) = 40
S      M0.0, 1  // 置位 阳极泵使能(M0.0)

Network 22
// 开机步骤40：压力达标 -> 进入步骤50

LD     SM0.0  // 读取 Always_On(SM0.0)
AB=    VB100, 40  // 判断 开机顺控状态(VB100) = 40
AW>=   VW1000, 1000  // 模拟量阈值比较（达到则进入下一步）
MOVB   50, VB100  // 开机进入步骤50（阴极泵）

Network 23
// 开机步骤50：启动阴极泵（使能位）并计时3秒

LD     SM0.0  // 读取 Always_On(SM0.0)
AB=    VB100, 50  // 判断 开机顺控状态(VB100) = 50
S      M0.1, 1  // 置位 阴极泵使能(M0.1)
TON    T39, 30  // 定时器 T39：3秒（100ms基准）

Network 24
// 开机步骤50：3秒到 -> 进入步骤60

LD     SM0.0  // 读取 Always_On(SM0.0)
AB=    VB100, 50  // 判断 开机顺控状态(VB100) = 50
A      T39  // 与 3秒延时(T39)
MOVB   60, VB100  // 开机进入步骤60（阴极阀）

Network 25
// 开机步骤60：开阴极液体阀并计时5分钟

LD     SM0.0  // 读取 Always_On(SM0.0)
AB=    VB100, 60  // 判断 开机顺控状态(VB100) = 60
S      Q0.5, 1  // 置位 阴极液体阀(Q0.5)
TON    T40, 3000  // 定时器 T40：5分钟（100ms基准）

Network 26
// 开机步骤60：5分钟到 -> 进入步骤70

LD     SM0.0  // 读取 Always_On(SM0.0)
AB=    VB100, 60  // 判断 开机顺控状态(VB100) = 60
A      T40  // 与 5分钟延时(T40)
MOVB   70, VB100  // 开机进入步骤70（直流电源）

Network 27
// 开机步骤70：使能直流电源 -> 运行状态

LD     SM0.0  // 读取 Always_On(SM0.0)
AB=    VB100, 70  // 判断 开机顺控状态(VB100) = 70
S      Q1.0, 1  // 置位 直流电源(Q1.0)
MOVB   100, VB100  // 开机完成：运行状态

// ==========================================
// 关机顺控状态机 (VB101)
// ==========================================
Network 28
// 关机步骤10：立即关闭阀/泵/制水/直流电源

LD     SM0.0  // 读取 Always_On(SM0.0)
AB=    VB101, 10  // 判断 关机顺控状态(VB101) = 10
R      Q1.0, 1  // 复位 直流电源(Q1.0)，数量=1
R      Q0.2, 2  // 复位 阳极补水阀(Q0.2)，数量=2
R      Q0.7, 1  // 复位 制水机(Q0.7)，数量=1
R      M0.1, 1  // 复位 阴极泵使能(M0.1)，数量=1
R      Q0.5, 1  // 复位 阴极液体阀(Q0.5)，数量=1
R      M0.0, 1  // 复位 阳极泵使能(M0.0)，数量=1
R      Q0.4, 1  // 复位 阳极电磁阀(Q0.4)，数量=1
MOVB   20, VB101  // 关机进入步骤20（延时）

Network 29
// 关机步骤20：延时30分钟

LD     SM0.0  // 读取 Always_On(SM0.0)
AB=    VB101, 20  // 判断 关机顺控状态(VB101) = 20
TON    T41, 18000  // 定时器 T41：30分钟（100ms基准）

Network 30
// AQ02 AO0 输出：阳极泵给定（使能时）

LD     M0.0  // 读取 阳极泵使能(M0.0)
MOVW   VW1120, AQW32  // 输出 AO0(阳极泵给定)(AQW32)：原始值=VW1120

Network 31
// AQ02 AO0 输出：未使能归零

LD     SM0.0  // 读取 Always_On(SM0.0)
AN     M0.0  // 与非 阳极泵使能(M0.0)
MOVW   0, AQW32  // 输出 AO0(阳极泵给定)：归零

Network 32
// AQ02 AO1 输出：阴极泵给定（使能时）

LD     M0.1  // 读取 阴极泵使能(M0.1)
MOVW   VW1122, AQW34  // 输出 AO1(阴极泵给定)(AQW34)：原始值=VW1122

Network 33
// AQ02 AO1 输出：未使能归零

LD     SM0.0  // 读取 Always_On(SM0.0)
AN     M0.1  // 与非 阴极泵使能(M0.1)
MOVW   0, AQW34  // 输出 AO1(阴极泵给定)：归零

// ==========================================
// 霍尔流量计脉冲（HSC0/HSC1）
// 喷嘴 Ø1.00mm：2223 pulses/litre（参见 docs/937-15xxF01_GB.pdf）
// 说明：本段输出为“脉冲/秒”和“瞬时流量(L/min×1000)”
// ==========================================
Network 34
// 初始化 HSC0（流量计1）

LD     SM0.1  // 读取 首次扫描(SM0.1)
MOVB   16#FC, SMB37  // HSC0 控制字
MOVW   0, SMW38  // HSC0 当前值清零
MOVW   0, SMW42  // HSC0 预置/比较值清零
HDEF   0, 0  // 定义 HSC0（模式0）
HSC    0  // 启动 HSC0

Network 35
// 初始化 HSC1（流量计2）

LD     SM0.1  // 读取 首次扫描(SM0.1)
MOVB   16#FC, SMB47  // HSC1 控制字
MOVW   0, SMW48  // HSC1 当前值清零
MOVW   0, SMW52  // HSC1 预置/比较值清零
HDEF   1, 0  // 定义 HSC1（模式0）
HSC    1  // 启动 HSC1

Network 36
// 1秒节拍（100ms×10）

LD     SM0.0  // 读取 Always_On(SM0.0)
AN     M10.2  // 与非 1秒节拍复位锁存(M10.2)
TON    T42, 10  // 定时器 T42：1秒（100ms基准）

Network 37
// 1秒采样：读取脉冲/秒并清零计数器

LD     T42  // 与 1秒节拍到(T42)
S      M10.2, 1  // 置位 1秒节拍复位锁存(M10.2)
MOVW   SMW38, VW1200  // 脉冲/秒：流量计1（HSC0 当前值低字）
MOVW   SMW48, VW1202  // 脉冲/秒：流量计2（HSC1 当前值低字）
MOVW   0, SMW38  // 清零 HSC0 当前值
MOVW   0, SMW48  // 清零 HSC1 当前值

Network 38
// 释放1秒节拍复位锁存

LD     M10.2  // 读取 1秒节拍复位锁存(M10.2)
AN     T42  // 与非 1秒节拍到(T42)
R      M10.2, 1  // 复位 1秒节拍复位锁存(M10.2)，数量=1

Network 39
// 默认瞬时流量清零（L/min×1000）

LD     SM0.0  // 读取 Always_On(SM0.0)
MOVW   0, VW1210  // 流量计1：瞬时流量 L/min×1000
MOVW   0, VW1212  // 流量计2：瞬时流量 L/min×1000

// Flow(L/min×1000) ≈ PulsesPerSec × 60000 / 2223
// 取整后近似为：每 1 pulse/s ≈ 27 (L/min×1000)
Network 40
// 流量计1：P>=1 -> 27

LD     SM0.0  // 读取 Always_On(SM0.0)
AW>=   VW1200, 1  // 比较 脉冲/秒：流量计1(VW1200) >= 1
MOVW   27, VW1210  // 流量计1：瞬时流量

Network 41
// 流量计1：P>=2 -> 54

LD     SM0.0  // 读取 Always_On(SM0.0)
AW>=   VW1200, 2  // 比较 脉冲/秒：流量计1(VW1200) >= 2
MOVW   54, VW1210  // 流量计1：瞬时流量

Network 42
// 流量计1：P>=3 -> 81

LD     SM0.0  // 读取 Always_On(SM0.0)
AW>=   VW1200, 3  // 比较 脉冲/秒：流量计1(VW1200) >= 3
MOVW   81, VW1210  // 流量计1：瞬时流量

Network 43
// 流量计1：P>=4 -> 108

LD     SM0.0  // 读取 Always_On(SM0.0)
AW>=   VW1200, 4  // 比较 脉冲/秒：流量计1(VW1200) >= 4
MOVW   108, VW1210  // 流量计1：瞬时流量

Network 44
// 流量计1：P>=5 -> 135

LD     SM0.0  // 读取 Always_On(SM0.0)
AW>=   VW1200, 5  // 比较 脉冲/秒：流量计1(VW1200) >= 5
MOVW   135, VW1210  // 流量计1：瞬时流量

Network 45
// 流量计1：P>=6 -> 162

LD     SM0.0  // 读取 Always_On(SM0.0)
AW>=   VW1200, 6  // 比较 脉冲/秒：流量计1(VW1200) >= 6
MOVW   162, VW1210  // 流量计1：瞬时流量

Network 46
// 流量计1：P>=7 -> 189

LD     SM0.0  // 读取 Always_On(SM0.0)
AW>=   VW1200, 7  // 比较 脉冲/秒：流量计1(VW1200) >= 7
MOVW   189, VW1210  // 流量计1：瞬时流量

Network 47
// 流量计1：P>=8 -> 216

LD     SM0.0  // 读取 Always_On(SM0.0)
AW>=   VW1200, 8  // 比较 脉冲/秒：流量计1(VW1200) >= 8
MOVW   216, VW1210  // 流量计1：瞬时流量

Network 48
// 流量计1：P>=9 -> 243

LD     SM0.0  // 读取 Always_On(SM0.0)
AW>=   VW1200, 9  // 比较 脉冲/秒：流量计1(VW1200) >= 9
MOVW   243, VW1210  // 流量计1：瞬时流量

Network 49
// 流量计1：P>=10 -> 270

LD     SM0.0  // 读取 Always_On(SM0.0)
AW>=   VW1200, 10  // 比较 脉冲/秒：流量计1(VW1200) >= 10
MOVW   270, VW1210  // 流量计1：瞬时流量

Network 50
// 流量计1：P>=11 -> 297

LD     SM0.0  // 读取 Always_On(SM0.0)
AW>=   VW1200, 11  // 比较 脉冲/秒：流量计1(VW1200) >= 11
MOVW   297, VW1210  // 流量计1：瞬时流量

Network 51
// 流量计1：P>=12 -> 324

LD     SM0.0  // 读取 Always_On(SM0.0)
AW>=   VW1200, 12  // 比较 脉冲/秒：流量计1(VW1200) >= 12
MOVW   324, VW1210  // 流量计1：瞬时流量

Network 52
// 流量计1：P>=13 -> 351

LD     SM0.0  // 读取 Always_On(SM0.0)
AW>=   VW1200, 13  // 比较 脉冲/秒：流量计1(VW1200) >= 13
MOVW   351, VW1210  // 流量计1：瞬时流量

Network 53
// 流量计1：P>=14 -> 378

LD     SM0.0  // 读取 Always_On(SM0.0)
AW>=   VW1200, 14  // 比较 脉冲/秒：流量计1(VW1200) >= 14
MOVW   378, VW1210  // 流量计1：瞬时流量

Network 54
// 流量计1：P>=15 -> 405

LD     SM0.0  // 读取 Always_On(SM0.0)
AW>=   VW1200, 15  // 比较 脉冲/秒：流量计1(VW1200) >= 15
MOVW   405, VW1210  // 流量计1：瞬时流量

Network 55
// 流量计1：P>=16 -> 432

LD     SM0.0  // 读取 Always_On(SM0.0)
AW>=   VW1200, 16  // 比较 脉冲/秒：流量计1(VW1200) >= 16
MOVW   432, VW1210  // 流量计1：瞬时流量

Network 56
// 流量计1：P>=17 -> 459

LD     SM0.0  // 读取 Always_On(SM0.0)
AW>=   VW1200, 17  // 比较 脉冲/秒：流量计1(VW1200) >= 17
MOVW   459, VW1210  // 流量计1：瞬时流量

Network 57
// 流量计1：P>=18 -> 486

LD     SM0.0  // 读取 Always_On(SM0.0)
AW>=   VW1200, 18  // 比较 脉冲/秒：流量计1(VW1200) >= 18
MOVW   486, VW1210  // 流量计1：瞬时流量

Network 58
// 流量计1：P>=19 -> 513

LD     SM0.0  // 读取 Always_On(SM0.0)
AW>=   VW1200, 19  // 比较 脉冲/秒：流量计1(VW1200) >= 19
MOVW   513, VW1210  // 流量计1：瞬时流量

Network 59
// 流量计1：P>=20 -> 540

LD     SM0.0  // 读取 Always_On(SM0.0)
AW>=   VW1200, 20  // 比较 脉冲/秒：流量计1(VW1200) >= 20
MOVW   540, VW1210  // 流量计1：瞬时流量

Network 60
// 流量计1：P>=21 -> 567

LD     SM0.0  // 读取 Always_On(SM0.0)
AW>=   VW1200, 21  // 比较 脉冲/秒：流量计1(VW1200) >= 21
MOVW   567, VW1210  // 流量计1：瞬时流量

Network 61
