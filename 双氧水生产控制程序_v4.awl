ORGANIZATION_BLOCK OB1
TITLE=Main Program

NETWORK 1
// Initialization
      LD     SM0.1
      MOVB   0, VB0
      MOVB   0, VB1
      MOVB   0, VB2
      MOVB   0, VB3

NETWORK 2
// Start Button
      LD     I0.0
      O      VB1
      AN     I0.1
      AN     I0.2
      =      VB1

NETWORK 3
// Stop Button
      LD     I0.1
      O      VB2
      AN     I0.0
      AN     I0.2
      =      VB2

NETWORK 4
// Emergency Stop
      LD     I0.2
      =      VB3

NETWORK 5
// Reset Button
      LD     I0.3
      AN     VB0
      R      VB3, 1

NETWORK 6
// Start Process
      LD     VB1
      AN     VB2
      AN     VB3
      CALL   SBR0

NETWORK 7
// Stop Process
      LD     VB2
      AN     VB1
      AN     VB3
      CALL   SBR1

NETWORK 8
// Emergency Stop Process
      LD     VB3
      CALL   SBR2

END_ORGANIZATION_BLOCK

SUBROUTINE_BLOCK SBR0: Start Process
TITLE=Start Process

NETWORK 1
// Step 1: Power On
      LD     SM0.0
      =      Q0.6

NETWORK 2
// Step 2: Pure Water Machine
      LD     SM0.0
      =      Q0.5

NETWORK 3
// Step 3: Water Supply
      LD     SM0.0
      =      Q0.0
      =      Q0.1

NETWORK 4
// Check Liquid Level
      LD     VB100
      >=I    100
      LD     VB104
      >=I    100
      ALD
      R      Q0.0, 1
      R      Q0.1, 1

NETWORK 5
// Step 4: Air Compressor
      LD     SM0.0
      =      Q0.4
      TON    T37, 30

NETWORK 6
// Step 5: Anode Solenoid
      LD     T37
      =      Q0.2
      TON    T38, 30

NETWORK 7
// Step 6: Anode Pump
      LD     T38

NETWORK 8
// Check Pressure
      LD     VD108
      >=D    100000
      =      Q0.3
      TON    T39, 30

NETWORK 9
// Step 8: Cathode Pump
      LD     T39
      TON    T40, 30

NETWORK 10
// Step 9: Cathode Solenoid
      LD     T40
      TON    T41, 30000

NETWORK 11
// Step 10: DC Power
      LD     T41
      MOVB   1, VB0

END_SUBROUTINE_BLOCK

SUBROUTINE_BLOCK SBR1: Stop Process
TITLE=Stop Process

NETWORK 1
// Step 1: Turn Off DC Power
      LD     SM0.0

NETWORK 2
// Step 2: Turn Off Water Supply
      LD     SM0.0
      R      Q0.0, 1
      R      Q0.1, 1

NETWORK 3
// Step 3: Turn Off Pure Water Machine
      LD     SM0.0
      R      Q0.5, 1

NETWORK 4
// Step 4: Turn Off Cathode System
      LD     SM0.0
      R      Q0.3, 1

NETWORK 5
// Step 5: Turn Off Anode System
      LD     SM0.0
      R      Q0.2, 1

NETWORK 6
// Step 6: Delay
      LD     SM0.0
      TON    T42, 1800000

NETWORK 7
// Step 7: Turn Off Air Compressor
      LD     T42
      R      Q0.4, 1

NETWORK 8
// Step 8: Turn Off Power
      LD     T42
      R      Q0.6, 1
      MOVB   0, VB0

END_SUBROUTINE_BLOCK

SUBROUTINE_BLOCK SBR2: Emergency Stop
TITLE=Emergency Stop

NETWORK 1
// Turn Off All Outputs
      LD     SM0.0
      R      Q0.0, 1
      R      Q0.1, 1
      R      Q0.2, 1
      R      Q0.3, 1
      R      Q0.4, 1
      R      Q0.5, 1
      R      Q0.6, 1
      MOVB   0, VB0
      MOVB   0, VB1
      MOVB   0, VB2

END_SUBROUTINE_BLOCK
