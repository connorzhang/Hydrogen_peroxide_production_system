SUBROUTINE_BLOCK HSC0_MON:SBR20
TITLE=HSC0 Monitor (1s read & reset)
BEGIN
Network 1 // 1秒节拍（100ms×10）
LD     SM0.0
AN     M10.0
TON    T42, 10

Network 2 // 1秒采样：读取HSC0计数（低字）并清零（得到脉冲/秒）
LD     T42
S      M10.0, 1
MOVW   SMW38, VW1004
MOVW   0, SMW38
MOVW   0, SMW40

Network 3 // 释放节拍锁存
LD     M10.0
AN     T42
R      M10.0, 1

END_SUBROUTINE_BLOCK
