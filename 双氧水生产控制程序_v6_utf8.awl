ORGANIZATION_BLOCK OB1

// ==========================================
// 初始化与急停复位
// ==========================================
NETWORK 1 // 首次扫描初始化
      LD     SM0.1
      MOVB   0, VB100
      MOVB   0, VB101
      R      Q0.0, 8
      R      Q1.0, 1
      R      M0.0, 2
      MOVW   16000, VW1120
      MOVW   16000, VW1122
      MOVW   0, AQW32
      MOVW   0, AQW34

NETWORK 2 // 急停处理 (I0.3)
      LD     I0.3
      MOVB   0, VB100
      MOVB   0, VB101
      R      Q0.0, 8
      R      Q1.0, 1
      R      M0.0, 2
      MOVW   0, AQW32
      MOVW   0, AQW34

// ==========================================
// 开机关机触发
// ==========================================
NETWORK 3 // 开机触发 (I0.1)
      LD     I0.1
      AN     I0.3
      AB=    VB100, 0
      AB=    VB101, 0
      MOVB   10, VB100

NETWORK 4 // 关机触发 (I0.2)
      LD     I0.2
      AN     I0.3
      MOVB   0, VB100
      MOVB   10, VB101

// ==========================================
// AE08 模拟量采集 (8路 4-20mA)
// 说明：按 S7-200 SMART 的固定映射惯例，首个右侧信号模块的模拟量起始通常为 AIW16。
// 若你的系统块里显示的起始地址不同，只需改这里的 AIWxx。
// ==========================================
NETWORK 5 // AE08 CH0 -> 高压罐压力(原始值)
      LD     SM0.0
      MOVW   AIW16, VW1000

NETWORK 6 // AE08 CH1 -> 阳极桶液位(原始值)
      LD     SM0.0
      MOVW   AIW18, VW1002

NETWORK 7 // AE08 CH2 -> 阴极桶液位(原始值)
      LD     SM0.0
      MOVW   AIW20, VW1004

NETWORK 8 // AE08 CH3 -> 备用模拟量1(原始值)
      LD     SM0.0
      MOVW   AIW22, VW1010

NETWORK 9 // AE08 CH4 -> 备用模拟量2(原始值)
      LD     SM0.0
      MOVW   AIW24, VW1012

NETWORK 10 // AE08 CH5 -> 备用模拟量3(原始值)
      LD     SM0.0
      MOVW   AIW26, VW1014

NETWORK 11 // AE08 CH6 -> 备用模拟量4(原始值)
      LD     SM0.0
      MOVW   AIW28, VW1016

NETWORK 12 // AE08 CH7 -> 备用模拟量5(原始值)
      LD     SM0.0
      MOVW   AIW30, VW1018

// ==========================================
// AQ02 模拟量输出 (2路)
// 说明：本项目硬件确定为 AQ02 起始 AQW32。
// 默认将两路输出用于两台泵调速（如变频器给定）：
//   AO0：AQW32  <- VW1120（阳极泵调速给定，原始值）
//   AO1：AQW34  <- VW1122（阴极泵调速给定，原始值）
// 当泵未使能时，输出强制为 0。
// ==========================================
NETWORK 13 // AO0 输出：使能时输出给定
      LD     M0.0
      MOVW   VW1120, AQW32

NETWORK 14 // AO0 输出：未使能时归零
      LD     SM0.0
      AN     M0.0
      MOVW   0, AQW32

NETWORK 15 // AO1 输出：使能时输出给定
      LD     M0.1
      MOVW   VW1122, AQW34

NETWORK 16 // AO1 输出：未使能时归零
      LD     SM0.0
      AN     M0.1
      MOVW   0, AQW34

// ==========================================
// 开机顺控状态机 (VB100)
// ==========================================
NETWORK 17 // 步骤10：制水与补水动作
      LD     SM0.0
      AB=    VB100, 10
      S      Q0.7, 1
      S      Q0.2, 1
      S      Q0.3, 1

NETWORK 18 // 步骤10：阳极液位达标停止补水
      LD     SM0.0
      AB=    VB100, 10
      AW>=   VW1002, 100
      R      Q0.2, 1

NETWORK 19 // 步骤10：阴极液位达标停止补水
      LD     SM0.0
      AB=    VB100, 10
      AW>=   VW1004, 100
      R      Q0.3, 1

NETWORK 20 // 步骤10转移：补水阀均关闭时进入步骤20
      LD     SM0.0
      AB=    VB100, 10
      AN     Q0.2
      AN     Q0.3
      MOVB   20, VB100

NETWORK 21 // 步骤20：启动空压机并计时
      LD     SM0.0
      AB=    VB100, 20
      S      Q0.6, 1
      TON    T37, 30

NETWORK 22 // 步骤20转移：延时3秒后进入步骤30
      LD     SM0.0
      AB=    VB100, 20
      A      T37
      MOVB   30, VB100

NETWORK 23 // 步骤30：打开阳极电磁阀并计时
      LD     SM0.0
      AB=    VB100, 30
      S      Q0.4, 1
      TON    T38, 30

NETWORK 24 // 步骤30转移：延时3秒后进入步骤40
      LD     SM0.0
      AB=    VB100, 30
      A      T38
      MOVB   40, VB100

NETWORK 25 // 步骤40：启动阳极泵（使能）
      LD     SM0.0
      AB=    VB100, 40
      S      M0.0, 1

NETWORK 26 // 步骤40转移：压力达到100kPa后进入步骤50
      LD     SM0.0
      AB=    VB100, 40
      AW>=   VW1000, 1000
      MOVB   50, VB100

NETWORK 27 // 步骤50：启动阴极泵（使能）并计时
      LD     SM0.0
      AB=    VB100, 50
      S      M0.1, 1
      TON    T39, 30

NETWORK 28 // 步骤50转移：延时3秒后进入步骤60
      LD     SM0.0
      AB=    VB100, 50
      A      T39
      MOVB   60, VB100

NETWORK 29 // 步骤60：打开阴极液体电磁阀并计时
      LD     SM0.0
      AB=    VB100, 60
      S      Q0.5, 1
      TON    T40, 3000

NETWORK 30 // 步骤60转移：延时5分钟后进入步骤70
      LD     SM0.0
      AB=    VB100, 60
      A      T40
      MOVB   70, VB100

NETWORK 31 // 步骤70：打开直流电源并完成开机
      LD     SM0.0
      AB=    VB100, 70
      S      Q1.0, 1
      MOVB   100, VB100

// ==========================================
// 关机顺控状态机 (VB101)
// ==========================================
NETWORK 32 // 关机步骤10：立即关闭大部分设备
      LD     SM0.0
      AB=    VB101, 10
      R      Q1.0, 1
      R      Q0.2, 2
      R      Q0.7, 1
      R      M0.1, 1
      R      Q0.5, 1
      R      M0.0, 1
      R      Q0.4, 1
      MOVB   20, VB101

NETWORK 33 // 关机步骤20：关机延时30分钟计时
      LD     SM0.0
      AB=    VB101, 20
      TON    T41, 18000

NETWORK 34 // 关机步骤20转移：时间到关空压机并完成关机
      LD     SM0.0
      AB=    VB101, 20
      A      T41
      R      Q0.6, 1
      MOVB   100, VB101

END_ORGANIZATION_BLOCK
