ORGANIZATION_BLOCK MAIN:OB1
TITLE=双氧水生产控制_完整并入HSC底层驱动版
// ==========================================
// 初始化与急停复位
// ==========================================
BEGIN
Network 1
// 首次扫描初始化（清零状态与输出，初始化两路HSC）
LD     SM0.1
MOVB   0, VB100  // 开机顺控状态清零
MOVB   0, VB101  // 关机顺控状态清零
R      Q0.0, 8   // 复位输出 Q0.0~Q0.7
R      Q1.0, 1   // 复位 直流电源(Q1.0)
R      M0.0, 2   // 复位 M0.0~M0.1（泵使能）
MOVW   13824, VW1120  // 写入 VW1120 = 13824（默认5V，阳极泵给定）
MOVW   13824, VW1122  // 写入 VW1122 = 13824（默认5V，阴极泵给定）

// 【新增】底层直接初始化 HSC0 (流量计1，I0.0，模式0)
MOVB   16#F8, SMB37
MOVD   +0, SMD38
MOVD   +2000000000, SMD42
HDEF   0, 0
HSC    0

// 【新增】底层直接初始化 HSC1 (流量计2，I0.6，模式0)
MOVB   16#F8, SMB47
MOVD   +0, SMD48
MOVD   +2000000000, SMD52
HDEF   1, 0
HSC    1

Network 2
// 每扫描必须保持 HSC 运行
LD     SM0.0
HSC    0
HSC    1

Network 3
// 急停处理（I0.3）
LD     I0.3
MOVB   0, VB100
MOVB   0, VB101
R      Q0.0, 8
R      Q1.0, 1
R      M0.0, 2
MOVW   13824, VW1120
MOVW   13824, VW1122

// ==========================================
// 开机关机触发
// ==========================================
Network 4
// 开机触发（I0.1）
LD     I0.1
AN     I0.3
AB=    VB100, 0
AB=    VB101, 0
MOVB   10, VB100

Network 5
// 关机触发（I0.2）
LD     I0.2
AN     I0.3
MOVB   0, VB100
MOVB   10, VB101

// ==========================================
// AE08 模拟量采集 (8路 4-20mA，起始AIW16)
// ==========================================
Network 6
// AE08 CH0 采集：压力 -> VW1000
LD     SM0.0
MOVW   AIW16, VW1000

Network 7
// AE08 CH1 采集：阳极液位 -> VW1002
LD     SM0.0
MOVW   AIW18, VW1002

Network 8
// AE08 CH2 采集：阴极液位 -> VW1004
LD     SM0.0
MOVW   AIW20, VW1004

// ==========================================
// 开机顺控状态机 (VB100)
// ==========================================
Network 9
// 开机步骤10：开制水+开补水阀
LD     SM0.0
AB=    VB100, 10
S      Q0.7, 1
S      Q0.2, 1
S      Q0.3, 1

Network 10
// 开机步骤10：阳极液位达标关阳极补水
LD     SM0.0
AB=    VB100, 10
AW>=   VW1002, 100
R      Q0.2, 1

Network 11
// 开机步骤10：阴极液位达标关阴极补水
LD     SM0.0
AB=    VB100, 10
AW>=   VW1004, 100
R      Q0.3, 1

Network 12
// 开机步骤10：两路补水阀都关 -> 进入步骤20
LD     SM0.0
AB=    VB100, 10
AN     Q0.2
AN     Q0.3
MOVB   20, VB100

Network 13
// 开机步骤20：启动空压机并计时3秒
LD     SM0.0
AB=    VB100, 20
S      Q0.6, 1
TON    T37, 30

Network 14
// 开机步骤20：3秒到 -> 进入步骤30
LD     SM0.0
AB=    VB100, 20
A      T37
MOVB   30, VB100

Network 15
// 开机步骤30：开阳极电磁阀并计时3秒
LD     SM0.0
AB=    VB100, 30
S      Q0.4, 1
TON    T38, 30

Network 16
// 开机步骤30：3秒到 -> 进入步骤40
LD     SM0.0
AB=    VB100, 30
A      T38
MOVB   40, VB100

Network 17
// 开机步骤40：启动阳极泵（使能位）
LD     SM0.0
AB=    VB100, 40
S      M0.0, 1

Network 18
// 开机步骤40：压力达标 -> 进入步骤50
LD     SM0.0
AB=    VB100, 40
AW>=   VW1000, 1000
MOVB   50, VB100

Network 19
// 开机步骤50：启动阴极泵（使能位）并计时3秒
LD     SM0.0
AB=    VB100, 50
S      M0.1, 1
TON    T39, 30

Network 20
// 开机步骤50：3秒到 -> 进入步骤60
LD     SM0.0
AB=    VB100, 50
A      T39
MOVB   60, VB100

Network 21
// 开机步骤60：开阴极液体阀并计时5分钟
LD     SM0.0
AB=    VB100, 60
S      Q0.5, 1
TON    T40, 3000

Network 22
// 开机步骤60：5分钟到 -> 进入步骤70
LD     SM0.0
AB=    VB100, 60
A      T40
MOVB   70, VB100

Network 23
// 开机步骤70：使能直流电源 -> 运行状态
LD     SM0.0
AB=    VB100, 70
S      Q1.0, 1
MOVB   100, VB100

// ==========================================
// 关机顺控状态机 (VB101)
// ==========================================
Network 24
// 关机步骤10：立即关闭阀/泵/制水/直流电源
LD     SM0.0
AB=    VB101, 10
R      Q1.0, 1
R      Q0.2, 2
R      Q0.7, 1
R      M0.1, 1
R      Q0.5, 1
R      M0.0, 1
R      Q0.4, 1
MOVB   20, VB101

Network 25
// 关机步骤20：延时30分钟
LD     SM0.0
AB=    VB101, 20
TON    T41, 18000

// ==========================================
// AQ02 模拟量输出 (AO0=AQW32, AO1=AQW34)
// ==========================================
Network 26
// AQ02 AO0 输出：阳极泵给定（使能时输出VW1120，否则归零）
LD     M0.0
MOVW   VW1120, AQW32

Network 27
// AQ02 AO0 输出：未使能归零
LD     SM0.0
AN     M0.0
MOVW   0, AQW32

Network 28
// AQ02 AO1 输出：阴极泵给定（使能时输出VW1122，否则归零）
LD     M0.1
MOVW   VW1122, AQW34

Network 29
// AQ02 AO1 输出：未使能归零
LD     SM0.0
AN     M0.1
MOVW   0, AQW34

// ==========================================
// 霍尔流量计脉冲计算与浮点换算
// ==========================================
Network 30
// 1秒测速节拍器 (T42)
LD     SM0.0
AN     M10.0
TON    T42, +10

Network 31
// 流量计1 (HSC0)：读总脉冲(VD1200)，算每秒脉冲(VD1208)
LD     T42
S      M10.0, 1
MOVD   HC0, VD1200
MOVD   VD1200, VD1208
-D     VD1204, VD1208
MOVD   VD1200, VD1204

Network 32
// 流量计2 (HSC1)：读总脉冲(VD1220)，算每秒脉冲(VD1228)
LD     T42
MOVD   HC1, VD1220
MOVD   VD1220, VD1228
-D     VD1224, VD1228
MOVD   VD1220, VD1224

Network 33
// 节拍复位
LD     M10.0
AN     T42
R      M10.0, 1

Network 34
// 流量计1 换算：转浮点数
LD     SM0.0
DTR    VD1208, VD1300
DTR    VD1200, VD1304

Network 35
// 流量计1 换算：瞬时流量 (VD1310, 单位 L/min)
LD     SM0.0
MOVR   VD1300, VD1310
*R     60.0, VD1310
/R     2223.0, VD1310

Network 36
// 流量计1 换算：累计流量 (VD1314, 单位 L)
LD     SM0.0
MOVR   VD1304, VD1314
/R     2223.0, VD1314

Network 37
// 流量计2 换算：转浮点数
LD     SM0.0
DTR    VD1228, VD1320
DTR    VD1220, VD1324

Network 38
// 流量计2 换算：瞬时流量 (VD1330, 单位 L/min)
LD     SM0.0
MOVR   VD1320, VD1330
*R     60.0, VD1330
/R     2223.0, VD1330

Network 39
// 流量计2 换算：累计流量 (VD1334, 单位 L)
LD     SM0.0
MOVR   VD1324, VD1334
/R     2223.0, VD1334

END_ORGANIZATION_BLOCK