ORGANIZATION_BLOCK OB1
TITLE=主程序
VERSION : 0.1

NETWORK 1
// 初始化
      LDSM0.1
      MOVB      0, VB0.0
      MOVB      0, VB0.1
      MOVB      0, VB0.2
      MOVB      0, VB0.3
      MOVW      0, C0
      MOVW      0, C1

NETWORK 2
// 开机按钮处理
      LDI0.0
      OVB0.1
      ANI0.1
      ANI0.2
      =VB0.1

NETWORK 3
// 关机按钮处理
      LDI0.1
      OVB0.2
      ANI0.0
      ANI0.2
      =VB0.2

NETWORK 4
// 急停按钮处理
      LDI0.2
      =VB0.3

NETWORK 5
// 复位按钮处理
      LDI0.3
      ANVB0.0
      RVB0.3, 1

NETWORK 6
// 开机流程控制
      LDV B0.1
      ANVB0.2
      ANVB0.3
      CALL      SBR_0

NETWORK 7
// 关机流程控制
      LDV B0.2
      ANVB0.1
      ANVB0.3
      CALL      SBR_1

NETWORK 8
// 急停处理
      LDV B0.3
      CALL      SBR_2

NETWORK 9
// 485通信处理
      LDSM0.0
      CALL      SBR_3

NETWORK 10
// PWM控制处理
      LDSM0.0
      CALL      SBR_4

NETWORK 11
// 高速计数处理
      LDSM0.0
      CALL      SBR_5

END_ORGANIZATION_BLOCK

SUBROUTINE_BLOCK SBR_0: 开机流程
TITLE=开机流程
VERSION : 0.1

NETWORK 1
// 步骤1：总电源
      LDSM0.0
      LPS
      MOVW      1, C0
      =Q0.6
      LRD
      MOVW      2, C0
      =Q0.5
      LRD
      MOVW      3, C0
      =Q0.0
      =Q0.1
      LRD
      LDB=      VB100, 100
      LDB=      VB104, 100
      ALD
      RQ0.0, 1
      RQ0.1, 1
      MOVW      4, C0
      LRD
      =Q0.4
      TON       T37, 30
      LDT37
      MOVW      5, C0
      =Q0.2
      TON       T38, 30
      LDT38
      MOVW      6, C0
      LRD
      LDD>=     VD108, 100000
      ALD
      MOVW      7, C0
      =Q0.3
      TON       T39, 30
      LDT39
      MOVW      8, C0
      TON       T40, 30
      LDT40
      MOVW      9, C0
      TON       T41, 30000
      LDT41
      MOVW      10, C0
      MOVB      1, VB0.0

END_SUBROUTINE_BLOCK

SUBROUTINE_BLOCK SBR_1: 关机流程
TITLE=关机流程
VERSION : 0.1

NETWORK 1
// 步骤1：关闭直流电源
      LDSM0.0
      LPS
      MOVW      1, C1
      LRD
      MOVW      2, C1
      RQ0.0, 1
      RQ0.1, 1
      LRD
      MOVW      3, C1
      RQ0.5, 1
      LRD
      MOVW      4, C1
      RQ0.3, 1
      LRD
      MOVW      5, C1
      RQ0.2, 1
      LRD
      MOVW      6, C1
      TON       T42, 1800000
      LDT42
      MOVW      7, C1
      RQ0.4, 1
      LRD
      MOVW      8, C1
      RQ0.6, 1
      MOVB      0, VB0.0

END_SUBROUTINE_BLOCK

SUBROUTINE_BLOCK SBR_2: 急停处理
TITLE=急停处理
VERSION : 0.1

NETWORK 1
// 关闭所有输出
      LDSM0.0
      RQ0.0, 1
      RQ0.1, 1
      RQ0.2, 1
      RQ0.3, 1
      RQ0.4, 1
      RQ0.5, 1
      RQ0.6, 1
      MOVB      0, VB0.0
      MOVB      0, VB0.1
      MOVB      0, VB0.2

END_SUBROUTINE_BLOCK

SUBROUTINE_BLOCK SBR_3: 485通信
TITLE=485通信
VERSION : 0.1

NETWORK 1
// 初始化通信参数
      LDSM0.1
      MOVB      96, SMB30

NETWORK 2
// 轮询设备
      LDSM0.0
      LPS
      MOVB      2, VB200
      MOVB      3, VB201
      CALL      Modbus_Read
      LRD
      MOVB      3, VB200
      MOVB      3, VB201
      CALL      Modbus_Read
      LRD
      MOVB      4, VB200
      MOVB      3, VB201
      CALL      Modbus_Read
      LRD
      MOVB      4, VB200
      MOVB      3, VB201
      CALL      Modbus_Read
      LRD
      MOVB      5, VB200
      MOVB      3, VB201
      CALL      Modbus_Read
      LRD
      MOVB      6, VB200
      MOVB      3, VB201
      CALL      Modbus_Read
      LRD
      LDV B0.0
      MOVB      1, VB200
      MOVB      6, VB201
      MOVW      5000, VW202
      CALL      Modbus_Write

END_SUBROUTINE_BLOCK

SUBROUTINE_BLOCK SBR_4: PWM控制
TITLE=PWM控制
VERSION : 0.1

NETWORK 1
// 初始化PWM
      LDSM0.1
      MOVB      16#80, SMB67
      MOVW      1000, SMW68
      MOVW      500, SMW70
      PWM       0, 1
      MOVB      16#80, SMB77
      MOVW      1000, SMW78
      MOVW      500, SMW80
      PWM       1, 1

NETWORK 2
// 阳极泵PWM控制
      LDV B0.0
      LPS
      LDD>=     VD108, 100000
      MOVW      300, SMW70
      LRD
      LDD<      VD108, 95000
      MOVW      700, SMW70

END_SUBROUTINE_BLOCK

SUBROUTINE_BLOCK SBR_5: 高速计数
TITLE=高速计数
VERSION : 0.1

NETWORK 1
// 初始化高速计数器0（流量计1）
      LDSM0.1
      MOVB      16#FC, SMB37
      MOVW      0, SMW38
      MOVW      0, SMW42
      HDEF      0, 0
      HSC       0
      MOVB      16#FC, SMB47
      MOVW      0, SMW48
      MOVW      0, SMW52
      HDEF      1, 0
      HSC       1

NETWORK 2
// 读取计数值
      LDSM0.0
      MOVW      HC0, VW300
      MOVW      HC1, VW302

END_SUBROUTINE_BLOCK

INTERRUPT_BLOCK INT_0: 高速计数中断
TITLE=高速计数中断
VERSION : 0.1

NETWORK 1
// 高速计数中断处理
      LDSM0.0

END_INTERRUPT_BLOCK
