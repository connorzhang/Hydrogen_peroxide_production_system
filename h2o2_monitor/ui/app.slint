import { VerticalBox, HorizontalBox } from "std-widgets.slint";

// --- 动画状态全局单例 ---
global AnimState {
    in-out property <float> tick: 0;
}

// 覆盖设备的图片组件 (用于状态变暗)
component DeviceOverlay inherits Rectangle {
    in property <bool> active: true;
    in property <image> source;
    width: 100%;
    height: 100%;
    background: transparent;

    // 1. 永远绘制原本的正常彩色图像
    Image {
        source: root.source;
        width: 100%;
        height: 100%;
    }
    
    // 2. 停机时，在上方叠加一层与原图形状完全相同的黑色半透明遮罩
    Image {
        source: root.source;
        width: 100%;
        height: 100%;
        colorize: #00000080; // 降低黑度，避免完全看不见
        visible: !root.active;
    }
}

// --- 核心流动效果组件 ---
component FlowPipe inherits Rectangle {
    in property <bool> active: false;
    in property <color> theme_color: #38bdf8;
    in property <bool> vertical: false;
    in property <bool> reverse: false; // 水平: true为向左流; 垂直: true为向上流

    clip: true;
    background: transparent;
    // 增加全局透明度，让底图管道的金属高光透过来，模拟"在管内"的错觉
    opacity: 0.65; // 调低透明度，使流动图更清透，与底图融合更完美

    Rectangle {
        width: vertical ? parent.width : parent.width + 60px;
        height: vertical ? parent.height + 60px : parent.height;
        x: !vertical ? (active ? (reverse ? (0px - AnimState.tick * 2px) : (-30px + AnimState.tick * 2px)) : -30px) : 0;
        y: vertical ? (active ? (reverse ? (0px - AnimState.tick * 2px) : (-30px + AnimState.tick * 2px)) : -30px) : 0;

        HorizontalLayout {
            if !vertical : HorizontalLayout {
                spacing: 28px;
                for i in 25: Rectangle {
                    width: 20px; height: parent.height;
                    background: active ? theme_color : transparent;
                    border-radius: parent.height/2;
                    // 移除 drop-shadow-blur 以大幅降低 CPU 和内存消耗
                }
            }
        }
        VerticalLayout {
            if vertical : VerticalLayout {
                spacing: 28px;
                for i in 25: Rectangle {
                    height: 20px; width: parent.width;
                    background: active ? theme_color : transparent;
                    border-radius: parent.width/2;
                    // 移除 drop-shadow-blur 以大幅降低 CPU 和内存消耗
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "双氧水工艺流程 - 组态监控系统";
    // 设置全屏和无边框
    width: 1280px;
    height: 1024px;
    no-frame: true;
    background: #020617;

    // 添加退出程序的回调
    callback request_exit();
    
    // 窗口拖拽回调
    callback window_drag_start(length, length);
    callback window_drag_update(length, length);

    // 最底层的全局拖拽区域
    TouchArea {
        width: 100%; height: 100%;
        z: -1; // 保持在最底层，不影响上面按钮的点击
        pointer-event(evt) => {
            if (evt.button == PointerEventButton.left && evt.kind == PointerEventKind.down) {
                root.window_drag_start(self.mouse-x, self.mouse-y);
            }
        }
        moved => {
            root.window_drag_update(self.mouse-x, self.mouse-y);
        }
    }

    in property <bool> q_water_maker: true;
    in property <bool> q_air_compressor: true;
    in property <bool> q_valve_anode: true;
    in property <bool> q_valve_cathode: true;
    in property <bool> q_dc_power: true;
    in property <bool> sys_alarm: false;

    in property <bool> flow_pure_to_cathode: false;
    in property <bool> flow_cathode_valve_to_corner: false;
    in property <bool> flow_cathode_vertical: false;
    in property <bool> flow_cathode_top: false;
    in property <bool> flow_pure_to_anode_cell: false;
    in property <bool> flow_anode_cell_to_valve: false;
    in property <bool> flow_anode_valve_to_corner: false;
    in property <bool> flow_anode_vertical: false;
    in property <bool> flow_anode_upper: false;
    in property <bool> flow_air_compressor: false;

    in property <float> pressure_mpa: 0.0;
    in property <float> pressure_anode: 0.0;
    in property <float> pressure_cathode: 0.0;
    in property <float> level_anode: 0.0;
    in property <float> level_cathode: 0.0;
    in property <float> flow_anode: 0.0;
    in property <float> flow_cathode: 0.0;
    in property <float> pump_anode_percent: 0.0;
    in property <float> pump_cathode_percent: 0.0;

    // 动画驱动定时器
    Timer {
        interval: 60ms;
        running: true;
        triggered => {
            AnimState.tick = AnimState.tick + 1;
            if (AnimState.tick >= 15) {
                AnimState.tick = 0;
            }
        }
    }

    Rectangle {
        // 保证底图和坐标系统的宽高比永远和原图 4838:3871 (1.2498) 保持一致
        width: min(root.width, root.height * 1.2498);
        height: min(root.height, root.width / 1.2498);
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        
        // 1. 底图 (纯背景底板)
        Image { source: @image-url("../../PNG_1280/双氧水软件界面底板.png"); width: 100%; height: 100%; }

        // 3. 跑马灯流动管线 (精准匹配底图像素坐标)
        // 阴极侧 (蓝色)
        // 纯水机到阴极阀
        FlowPipe { x: parent.width * 0.310; y: parent.height * 0.706; width: 19.0%; height: 1.2%; theme_color: #38bdf8; active: root.flow_pure_to_cathode; reverse: true; }
        // 阴极阀到左下转角
        FlowPipe { x: parent.width * 0.188; y: parent.height * 0.706; width: 12.2%; height: 1.2%; theme_color: #38bdf8; active: root.flow_cathode_valve_to_corner; reverse: true; }
        // 左垂直管道
        FlowPipe { x: parent.width * 0.188; y: parent.height * 0.326; width: 1.0%; height: 39.2%; theme_color: #38bdf8; vertical: true; active: root.flow_cathode_vertical; reverse: true; }
        // 左上角到顶部设备
        FlowPipe { x: parent.width * 0.188; y: parent.height * 0.330; width: 19.0%; height: 1.2%; theme_color: #38bdf8; active: root.flow_cathode_top; reverse: false; }

        // 阳极侧 (橙色与青色混合)
        // 纯水机到电解槽 (Cyan)
        FlowPipe { x: parent.width * 0.500; y: parent.height * 0.706; width: 11.3%; height: 1.2%; theme_color: #38bdf8; active: root.flow_pure_to_anode_cell; reverse: false; }
        // 电解槽到阳极阀 (橙色)
        FlowPipe { x: parent.width * 0.613; y: parent.height * 0.706; width: 3.7%; height: 1.2%; theme_color: #f97316; active: root.flow_anode_cell_to_valve; reverse: false; }
        // 阳极阀到右下角 (橙色)
        FlowPipe { x: parent.width * 0.650; y: parent.height * 0.706; width: 16.0%; height: 1.2%; theme_color: #f97316; active: root.flow_anode_valve_to_corner; reverse: false; }
        // 右下角到右上角 (垂直 橙色)
        FlowPipe { x: parent.width * 0.800; y: parent.height * 0.454; width: 1.0%; height: 26.4%; theme_color: #f97316; vertical: true; active: root.flow_anode_vertical; reverse: true; }
        // 右上角到中间设备 (水平中 橙色)
        FlowPipe { x: parent.width * 0.613; y: parent.height * 0.454; width: 19.7%; height: 1.2%; theme_color: #f97316; active: root.flow_anode_upper; reverse: true; }

        // 压缩机侧 (蓝色)
        FlowPipe { x: parent.width * 0.628; y: parent.height * 0.330; width: 20.3%; height: 1.2%; theme_color: #38bdf8; active: root.flow_air_compressor; reverse: true; }

        // 4. 设备与管道覆盖层 (静态组件叠加)
        Image { source: @image-url("../../PNG_1280/管道流露.png"); width: 100%; height: 100%; }
        Image { source: @image-url("../../PNG_1280/纯水机.png"); width: 100%; height: 100%; }
        Image { source: @image-url("../../PNG_1280/压缩机.png"); width: 100%; height: 100%; }
        Image { source: @image-url("../../PNG_1280/阳极泵.png"); width: 100%; height: 100%; }
        Image { source: @image-url("../../PNG_1280/阳极阀.png"); width: 100%; height: 100%; }
        Image { source: @image-url("../../PNG_1280/阳极流量.png"); width: 100%; height: 100%; }
        Image { source: @image-url("../../PNG_1280/阳极液位.png"); width: 100%; height: 100%; }
        Image { source: @image-url("../../PNG_1280/阴极压力高压罐压力.png"); width: 100%; height: 100%; }
        Image { source: @image-url("../../PNG_1280/阳极压力.png"); width: 100%; height: 100%; }
        Image { source: @image-url("../../PNG_1280/阴极泵.png"); width: 100%; height: 100%; }
        Image { source: @image-url("../../PNG_1280/阳极补水阀.png"); width: 100%; height: 100%; }
        Image { source: @image-url("../../PNG_1280/阴极阀.png"); width: 100%; height: 100%; }
        Image { source: @image-url("../../PNG_1280/阴极补水阀.png"); width: 100%; height: 100%; }
        Image { source: @image-url("../../PNG_1280/阴极流量.png"); width: 100%; height: 100%; }
        Image { source: @image-url("../../PNG_1280/阴极液位.png"); width: 100%; height: 100%; }

        // 设备状态覆盖层 (通过变暗来表示停止状态)
        DeviceOverlay { source: @image-url("../../PNG_1280/纯水机.png"); active: root.q_water_maker; }
        DeviceOverlay { source: @image-url("../../PNG_1280/压缩机.png"); active: root.q_air_compressor; }
        DeviceOverlay { source: @image-url("../../PNG_1280/阳极泵.png"); active: root.q_valve_anode; }
        DeviceOverlay { source: @image-url("../../PNG_1280/阳极阀.png"); active: root.q_valve_anode; }
        DeviceOverlay { source: @image-url("../../PNG_1280/阴极泵.png"); active: root.q_valve_cathode; }
        DeviceOverlay { source: @image-url("../../PNG_1280/阴极阀.png"); active: root.q_valve_cathode; }
        DeviceOverlay { source: @image-url("../../PNG_1280/阴极补水阀.png"); active: root.q_valve_cathode; }
        DeviceOverlay { source: @image-url("../../PNG_1280/阳极补水阀.png"); active: root.q_valve_anode; }
        
        // 5. 数据数值与静态标签层
        // 产品/反应堆相关标签
        Text { x: parent.width * 0.230; y: parent.height * 0.440; text: "双氧水"; color: #e2e8f0; font-size: 16px; font-weight: 700; }
        Text { x: parent.width * 0.470; y: parent.height * 0.540; text: "电解槽"; color: #e2e8f0; font-size: 18px; font-weight: 700; }
        
        // 压缩机标签
        Text { x: parent.width * 0.860; y: parent.height * 0.220; text: "压缩机"; color: #e2e8f0; font-size: 16px; font-weight: 700; }

        // 阴极侧标签与数值 (左侧)
        Text { x: parent.width * 0.2343; y: parent.height * 0.1900; text: round(root.pressure_cathode * 100)/100 + " kPa"; color: #38bdf8; font-size: 20px; font-weight: 800; }
        Text { x: parent.width * 0.2343; y: parent.height * 0.2250; text: "阴极压力kPa"; color: #94a3b8; font-size: 14px; font-weight: 700; }
        
        Text { x: parent.width * 0.1015; y: parent.height * 0.5150; text: "阴极流量L/min"; color: #94a3b8; font-size: 14px; font-weight: 700; }
        Text { x: parent.width * 0.1015; y: parent.height * 0.5500; text: round(root.flow_cathode * 10)/10 + " L/min"; color: #38bdf8; font-size: 20px; font-weight: 800; }
        
        Text { x: parent.width * 0.1250; y: parent.height * 0.7750; text: "阴极泵%"; color: #94a3b8; font-size: 14px; font-weight: 700; }
        Text { x: parent.width * 0.1250; y: parent.height * 0.8100; text: round(root.pump_cathode_percent) + " %"; color: #38bdf8; font-size: 20px; font-weight: 800; }
        
        Text { x: parent.width * 0.3125; y: parent.height * 0.8050; text: "阴极液位cm"; color: #94a3b8; font-size: 14px; font-weight: 700; }
        Text { x: parent.width * 0.3125; y: parent.height * 0.8400; text: round(root.level_cathode * 10)/10 + " cm (" + round(root.level_cathode / 65.0 * 100.0) + "%)"; color: #38bdf8; font-size: 20px; font-weight: 800; }
        
        Text { x: parent.width * 0.2500; y: parent.height * 0.7600; text: "阴极阀"; color: #94a3b8; font-size: 14px; font-weight: 700; }
        Text { x: parent.width * 0.3900; y: parent.height * 0.7600; text: "阴极补水阀"; color: #94a3b8; font-size: 14px; font-weight: 700; }

        // 纯水机标签
        Text { x: parent.width * 0.4850; y: parent.height * 0.8500; text: "纯水机"; color: #e2e8f0; font-size: 16px; font-weight: 700; }

        // 阳极侧标签与数值 (右侧)
        Text { x: parent.width * 0.8281; y: parent.height * 0.7750; text: "阳极泵%"; color: #94a3b8; font-size: 14px; font-weight: 700; }
        Text { x: parent.width * 0.8281; y: parent.height * 0.8100; text: round(root.pump_anode_percent) + " %"; color: #f97316; font-size: 20px; font-weight: 800; }
        
        Text { x: parent.width * 0.8281; y: parent.height * 0.5150; text: "阳极流量L/min"; color: #94a3b8; font-size: 14px; font-weight: 700; }
        Text { x: parent.width * 0.8281; y: parent.height * 0.5500; text: round(root.flow_anode * 10)/10 + " L/min"; color: #f97316; font-size: 20px; font-weight: 800; }
        
        Text { x: parent.width * 0.6562; y: parent.height * 0.8050; text: "阳极液位cm"; color: #94a3b8; font-size: 14px; font-weight: 700; }
        Text { x: parent.width * 0.6562; y: parent.height * 0.8400; text: round(root.level_anode * 10)/10 + " cm (" + round(root.level_anode / 65.0 * 100.0) + "%)"; color: #f97316; font-size: 20px; font-weight: 800; }
        
        Text { x: parent.width * 0.7187; y: parent.height * 0.3600; text: round(root.pressure_anode * 100)/100 + " kPa"; color: #f97316; font-size: 20px; font-weight: 800; }
        Text { x: parent.width * 0.7187; y: parent.height * 0.3950; text: "阳极压力kPa"; color: #94a3b8; font-size: 14px; font-weight: 700; }
        
        Text { x: parent.width * 0.7187; y: parent.height * 0.1900; text: round(root.pressure_mpa * 100)/100 + " kPa"; color: #a855f7; font-size: 20px; font-weight: 800; }
        Text { x: parent.width * 0.7187; y: parent.height * 0.2250; text: "高压罐压力kPa"; color: #94a3b8; font-size: 14px; font-weight: 700; }
        
        Text { x: parent.width * 0.5600; y: parent.height * 0.7600; text: "阳极补水阀"; color: #94a3b8; font-size: 14px; font-weight: 700; }
        Text { x: parent.width * 0.6800; y: parent.height * 0.7600; text: "阳极阀"; color: #94a3b8; font-size: 14px; font-weight: 700; }
        
        Rectangle {
            x: parent.width * 0.4000; y: parent.height * 0.9000;
            width: parent.width * 0.2000; height: parent.height * 0.1000;
            background: transparent;

            Text {
                width: 100%; height: 100%;
                horizontal-alignment: center; vertical-alignment: center;
                text: root.sys_alarm ? "系统故障/报警" : "系统正常运行";
                color: root.sys_alarm ? #ef4444 : #10b981;
                font-size: 24px; font-weight: 800;
            }

            TouchArea {
                width: 100%; height: 100%;
                clicked => { root.request_exit(); }
            }
        }
    }
}
