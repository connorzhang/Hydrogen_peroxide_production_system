ORGANIZATION_BLOCK MAIN:OB1
TITLE= ==========================================
//  初始化与急停复位
//  ==========================================
BEGIN
Network 1 
LD     SM0.1
MOVB   0, VB100
MOVB   0, VB101
R      Q0.0, 8
R      Q1.0, 1
R      M0.0, 2

Network 2 //  急停处理 (I0.3)
LD     I0.3
MOVB   0, VB100
MOVB   0, VB101
R      Q0.0, 8
R      Q1.0, 1
R      M0.0, 2

// ==========================================
// 开机关机触发
// ==========================================
Network 3 //  开机触发 (I0.1)
LD     I0.1
AN     I0.3
AB=    VB100, 0
AB=    VB101, 0
MOVB   10, VB100

Network 4 //  关机触发 (I0.2)
LD     I0.2
AN     I0.3
MOVB   0, VB100
MOVB   10, VB101

// ==========================================
// AE08 模拟量采集 (8路 4-20mA)
// 说明：按 S7-200 SMART 的固定映射惯例，首个右侧信号模块的模拟量起始通常为 AIW16。
// 若你的系统块里显示的起始地址不同，只需改这里的 AIWxx。
// ==========================================
Network 5 //  AE08 CH0 -> 高压罐压力(原始值)
LD     SM0.0
MOVW   AIW16, VW1000

Network 6 //  AE08 CH1 -> 阳极桶液位(原始值)
LD     SM0.0
MOVW   AIW18, VW1002

Network 7 //  AE08 CH2 -> 阴极桶液位(原始值)
LD     SM0.0
MOVW   AIW20, VW1004

Network 8 //  AE08 CH3 -> 备用模拟量1(原始值)
LD     SM0.0
MOVW   AIW22, VW1010

Network 9 //  AE08 CH4 -> 备用模拟量2(原始值)
LD     SM0.0
MOVW   AIW24, VW1012

Network 10 //  AE08 CH5 -> 备用模拟量3(原始值)
LD     SM0.0
MOVW   AIW26, VW1014

Network 11 //  AE08 CH6 -> 备用模拟量4(原始值)
LD     SM0.0
MOVW   AIW28, VW1016

Network 12 //  AE08 CH7 -> 备用模拟量5(原始值)
LD     SM0.0
MOVW   AIW30, VW1018

// ==========================================
// 开机顺控状态机 (VB100)
// ==========================================
Network 13 //  步骤10：制水与补水动作
LD     SM0.0
AB=    VB100, 10
S      Q0.7, 1
S      Q0.2, 1
S      Q0.3, 1

Network 14 //  步骤10：阳极液位达标停止补水
LD     SM0.0
AB=    VB100, 10
AW>=   VW1002, 100
R      Q0.2, 1

Network 15 //  步骤10：阴极液位达标停止补水
LD     SM0.0
AB=    VB100, 10
AW>=   VW1004, 100
R      Q0.3, 1

Network 16 //  步骤10转移：补水阀均关闭时进入步骤20
LD     SM0.0
AB=    VB100, 10
AN     Q0.2
AN     Q0.3
MOVB   20, VB100

Network 17 //  步骤20：启动空压机并计时
LD     SM0.0
AB=    VB100, 20
S      Q0.6, 1
TON    T37, 30

Network 18 //  步骤20转移：延时3秒后进入步骤30
LD     SM0.0
AB=    VB100, 20
A      T37
MOVB   30, VB100

Network 19 //  步骤30：打开阳极电磁阀并计时
LD     SM0.0
AB=    VB100, 30
S      Q0.4, 1
TON    T38, 30

Network 20 //  步骤30转移：延时3秒后进入步骤40
LD     SM0.0
AB=    VB100, 30
A      T38
MOVB   40, VB100

Network 21 //  步骤40：启动阳极泵 (PWM1使能)
LD     SM0.0
AB=    VB100, 40
S      M0.0, 1

Network 22 //  步骤40转移：压力达到100kPa后进入步骤50
LD     SM0.0
AB=    VB100, 40
AW>=   VW1000, 1000
MOVB   50, VB100

Network 23 //  步骤50：启动阴极泵 (PWM2使能)并计时
LD     SM0.0
AB=    VB100, 50
S      M0.1, 1
TON    T39, 30

Network 24 //  步骤50转移：延时3秒后进入步骤60
LD     SM0.0
AB=    VB100, 50
A      T39
MOVB   60, VB100

Network 25 //  步骤60：打开阴极液体电磁阀并计时
LD     SM0.0
AB=    VB100, 60
S      Q0.5, 1
TON    T40, 3000

Network 26 //  步骤60转移：延时5分钟后进入步骤70
LD     SM0.0
AB=    VB100, 60
A      T40
MOVB   70, VB100

Network 27 //  步骤70：打开直流电源并完成开机
LD     SM0.0
AB=    VB100, 70
S      Q1.0, 1
MOVB   100, VB100

// ==========================================
// 关机顺控状态机 (VB101)
// ==========================================
Network 28 //  关机步骤10：立即关闭大部分设备
LD     SM0.0
AB=    VB101, 10
R      Q1.0, 1
R      Q0.2, 2
R      Q0.7, 1
R      M0.1, 1
R      Q0.5, 1
R      M0.0, 1
R      Q0.4, 1
MOVB   20, VB101

Network 29 //  关机步骤20：关机延时30分钟计时
LD     SM0.0
AB=    VB101, 20
TON    T41, 18000

Network 30 
LD     SM0.0
=      L60.0
LDN    M0.0
=      L63.7
LD     L60.0
CALL   SBR0, L63.7, 20, 10, VB100
Network 31 
// 配置默认5V输出测试
LD     SM0.0
MOVW   13824, AQW32
END_ORGANIZATION_BLOCK
SUBROUTINE_BLOCK PWM0_RUN:SBR0
TITLE=该指令由 PTO/PWM 向导生成，旨在与输出 Q0.0 配合使用. 该输出用作采用同步更新并基于 毫秒 时基的 PWM.
VAR_INPUT
RUN:BOOL;	// 运行/停止
Cycle:WORD;	// 周期时间 (2-65535 ms)
Pulse:WORD;	// 脉冲时间宽度 (0-65535)
END_VAR
VAR_OUTPUT
Error:BYTE;
END_VAR
VAR
Control_Byte:BYTE;
Tmp_Array:BYTE;
Tmp_Array2:BYTE;
Tmp_Array3:BYTE;
Tmp_Array4:BYTE;
Tmp_Array5:BYTE;
END_VAR
BEGIN
Network 1 // 此 POU 针对编辑和查看设置了密码保护.

END_SUBROUTINE_BLOCK
