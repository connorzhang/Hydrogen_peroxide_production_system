SUBROUTINE_BLOCK SBR20: HSC0 Monitor
TITLE=HSC0 Monitor (1s delta)
BEGIN
NETWORK 1
// 1秒节拍（100ms×10）

LD     SM0.0
AN     M10.0
TON    T42, 10

NETWORK 2
// 1秒采样：读取HSC0计数并计算Δ脉冲/秒

LD     T42
S      M10.0, 1
MOVW   SMW38, VW1002
SUBW   VW1004, VW1002, VW1000
MOVW   VW1002, VW1000

NETWORK 3
// 释放节拍锁存

LD     M10.0
AN     T42
R      M10.0, 1

END_SUBROUTINE_BLOCK
